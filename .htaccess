Options -MultiViews -Indexes

RewriteEngine On

# Redirect semua request ke folder /public (solusi Laravel di shared hosting)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L,QSA]

# ==========================================
# KEAMANAN EKSTRA (WAJIB UNTUK SHARED HOSTING)
# ==========================================
# Blokir akses langsung ke file .env dan database SQLite
<FilesMatch "^\.env|database\.sqlite$">
    Require all denied
</FilesMatch>

# Blokir akses directory listing dan URL database/storage
RewriteRule ^(database|storage/logs)/ - [F,L]

# Config Upload & Memory Limits untuk High Concurrency & File Upload
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>
