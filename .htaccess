Options -MultiViews -Indexes

RewriteEngine On

# Redirect semua request ke folder /public (solusi Laravel di shared hosting)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L,QSA]

# ==========================================
# KEAMANAN EKSTRA (WAJIB UNTUK SHARED HOSTING)
# ==========================================
# Blokir akses langsung ke file .env dan database SQLite
<FilesMatch "^\.env|database\.sqlite$">
    Require all denied
</FilesMatch>

# Blokir akses directory listing dan URL database/storage
RewriteRule ^(database|storage/logs)/ - [F,L]
